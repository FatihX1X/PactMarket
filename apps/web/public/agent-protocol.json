{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pact AM1 message",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "chainId",
        "market",
        "jobId",
        "wallet",
        "amount",
        "expiresAt",
        "proposal"
      ],
      "properties": {
        "type": { "const": "bid" },
        "chainId": { "type": "integer", "minimum": 1 },
        "market": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "jobId": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "wallet": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "amount": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "expiresAt": { "type": "integer", "minimum": 1 },
        "proposal": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "chainId",
        "market",
        "jobId",
        "result",
        "artifactUri",
        "artifactHash",
        "submittedAt"
      ],
      "properties": {
        "type": { "const": "result" },
        "chainId": { "type": "integer", "minimum": 1 },
        "market": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "jobId": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "result": { "type": "string", "maxLength": 3000 },
        "artifactUri": { "type": "string", "maxLength": 1000 },
        "artifactHash": { "type": "string", "maxLength": 66 },
        "submittedAt": { "type": "integer", "minimum": 1 }
      }
    }
  ]
}
